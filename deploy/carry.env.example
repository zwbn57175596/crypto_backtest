# Copy to /home/ubuntu/.secrets/carry.env and chmod 600. NEVER commit real values.
# OKX (use a key with Trade permission, NO Withdraw; bind it to this server's public IP)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# Set OKX_DEMO=1 to use OKX demo trading (needs a demo-trading API key)
OKX_DEMO=
# Spot trade mode used for spot orders (verify on demo; default cash)
OKX_SPOT_TD_MODE=
# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email notifications (SMTP over SSL on 465, or STARTTLS on 587)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Dead-man's switch: a Healthchecks.io-style ping URL. The runner GETs it once per
# successful heartbeat; leave empty to disable. Set the check's expected period to
# the heartbeat interval (default 1h) with a similar grace window.
HEALTHCHECK_PING_URL=
