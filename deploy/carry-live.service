[Unit]
Description=Funding carry engine LIVE (OKX spot long + USDT-perp short, 1.0x, real money)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/crypto_backtest
EnvironmentFile=/home/ubuntu/.secrets/carry-live.env
Environment=PYTHONPATH=/home/ubuntu/crypto_backtest/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/crypto_backtest/.venv/bin/python -m carry \
    --config /home/ubuntu/crypto_backtest/config/carry-live.json \
    --log /home/ubuntu/crypto_backtest/live_state/carry-live.log run
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=300
RestartPreventExitStatus=2 3

[Install]
WantedBy=multi-user.target
