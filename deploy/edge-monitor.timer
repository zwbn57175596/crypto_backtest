[Unit]
Description=Weekly crypto MR edge health check

[Timer]
# Every Monday 08:00 UTC. Adjust as you like (OnCalendar uses the container's tz).
OnCalendar=Mon *-*-* 08:00:00
# If the box was off at the scheduled time, run at next boot.
Persistent=true
# Small random delay to avoid hammering the exchange API on the dot.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
