[Unit]
Description=Weekly crypto MR edge health check

[Timer]
# Hourly, a few minutes after each 1h candle closes (so the just-closed bar is
# available). Change OnCalendar to reschedule.
OnCalendar=*-*-* *:05:00
# If the box was off at the scheduled time, run once at next boot/timer start.
Persistent=true
# Small jitter to avoid hitting the exchange API exactly on the minute.
RandomizedDelaySec=90

[Install]
WantedBy=timers.target
