[Unit]
Description=Crypto Trading Web Monitor
After=network.target

[Service]
WorkingDirectory=/home/ubuntu/crypto_backtest
EnvironmentFile=/home/ubuntu/.secrets/web.env
ExecStart=/home/ubuntu/crypto_backtest/.venv/bin/python -m backtest web \
    --port 16800 \
    --live-db /home/ubuntu/crypto_backtest/data/live_history.db \
    --log-dir /home/ubuntu/crypto_backtest/data/logs
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
